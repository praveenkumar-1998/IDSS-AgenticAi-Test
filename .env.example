# Copy to .env. Only the block for the provider you pick is needed.

# ollama (local, free) | gemini | openai | anthropic
LLM_PROVIDER=ollama
# LLM_MODEL=            # overrides the provider default below
# LLM_TEMPERATURE=0

OLLAMA_MODEL=llama3.2:3b
# OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_NUM_CTX=8192

GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest

OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=
# AGENT_MODEL=claude-sonnet-5-5

# Service URLs. Defaults live in services.toml; these override per environment.
CUSTOMER_SERVICE_URL=http://127.0.0.1:8001
PRODUCT_SERVICE_URL=http://127.0.0.1:8002
ORDER_SERVICE_URL=http://127.0.0.1:8003

# Guardrails
# AGENT_READ_ONLY=false         # true hides every create/update/delete tool
# AGENT_CONFIRM_WRITES=false    # true asks before any write, not just deletes/cancels
# AGENT_MAX_STEPS=12            # tool rounds per question before giving up
# AGENT_ROUTER_THRESHOLD=30     # route to a subset of services above this many tools
# AGENT_HISTORY_MESSAGES=30
# AGENT_MAX_TOOL_CHARS=12000

# Optional LangSmith tracing
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
